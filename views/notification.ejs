

<script src="/js/push.js"></script>

<script>
  // page load হলে 2 সেকেন্ড পরে push permission চাওয়া হবে
  window.addEventListener("load", () => {

    setTimeout(async () => {

      // যদি আগেই granted থাকে তাহলে আর permission চাওয়া হবে না
      if (Notification.permission === "granted") return;

      // service worker এবং push subscription শুরু করবে
      await initPush("<%= publicKey %>");

    }, 2000); // 2 second delay

  });
</script>