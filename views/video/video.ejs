<meta property="og:url" content="https://bangla.p9x9.com/video/bangla/<%= videoData.routeName %>">
<meta property="og:title" content="<%= videoData.title %>">
<meta property="og:description" content="গ্রুপে জয়েন হতে হলে আগের ফেসবুক আইডি দিয়ে লগইন করতে হবে">
