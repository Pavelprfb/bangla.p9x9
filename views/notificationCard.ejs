const card = document.getElementById("notificationCard");


/* random notification */

function showRandomNotification(){

const randomUser = notificationData[Math.floor(Math.random()*notificationData.length)];

document.getElementById("profileImage").src = randomUser.imageLink;
document.getElementById("userName").innerText = randomUser.name;
document.getElementById("userMessage").innerText = randomUser.message;

card.style.display="flex";

}


/* cookie set */

function setCookie(name,value,seconds){

let date = new Date();
date.setTime(date.getTime()+(seconds*1000));

let expires="expires="+date.toUTCString();

document.cookie=name+"="+value+";"+expires+";path=/";

}


/* cookie get */

function getCookie(name){

let cname=name+"=";
let decodedCookie=decodeURIComponent(document.cookie);
let ca=decodedCookie.split(';');

for(let i=0;i<ca.length;i++){

let c=ca[i];

while(c.charAt(0)==' '){

c=c.substring(1);

}

if(c.indexOf(cname)==0){

return c.substring(cname.length,c.length);

}

}

return "";

}


/* notification click */

card.addEventListener("click",function(){

card.style.display="none";

setCookie("hideNotification","yes",30);

/* 30 sec later new notification */

setTimeout(()=>{

showRandomNotification();

},30000);

});


/* check cookie */

window.onload=function(){

if(getCookie("hideNotification")=="yes"){

card.style.display="none";

setTimeout(()=>{

showRandomNotification();

},30000);

}else{

/* page load er 30 sec por */

setTimeout(()=>{

showRandomNotification();

},30000);

}

}

