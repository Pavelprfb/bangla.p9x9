<h2>Create Task</h2>

<form action="/admin/task/create" method="POST">
  <input type="text" name="taskPic" placeholder="Task Image URL" required><br><br>

  <input type="text" name="fullName" placeholder="Task Name" required><br><br>

  <input type="number" name="coin" placeholder="Coin" required><br><br>

  <input type="text" name="link" placeholder="Task Link" required><br><br>

  <button type="submit">Create Task</button>
</form>