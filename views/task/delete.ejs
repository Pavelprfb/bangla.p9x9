<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Delete Tasks</title>
<link rel="icon" type="image/x-icon" href="/images/favicon.ico">
<style>
*{ margin:0; padding:0; box-sizing:border-box; font-family:'Segoe UI', sans-serif; }
body{ background: linear-gradient(135deg, #141e30, #243b55); color:#fff; padding:20px; }
h2{ text-align:center; margin-bottom:30px; }

/* Task card */
.task-card{
  background: rgba(255,255,255,0.05);
  padding:15px 20px;
  border-radius:12px;
  margin-bottom:15px;
  display:flex;
  justify-content: space-between;
  align-items:center;
  border:1px solid rgba(255,255,255,0.08);
  backdrop-filter: blur(8px);
}

.task-card p{
  margin:0;
  font-weight:500;
}

/* Delete button */
.task-card button{
  padding:6px 12px;
  border:none;
  border-radius:6px;
  cursor:pointer;
  background: linear-gradient(45deg, #ff4141, #d70000);
  color:#fff;
  font-weight:600;
  transition:0.3s;
}

.task-card button:hover{
  transform: scale(1.05);
  box-shadow:0 5px 15px rgba(255,65,65,0.4);
}

@media(max-width:480px){
  .task-card{ flex-direction:column; gap:10px; align-items:flex-start; }
}
</style>
</head>
<body>

<h2>Delete Tasks</h2>

<% tasks.forEach(task => { %>
  <div class="task-card">
    <p><%= task.fullName %> | <%= task.coin %> Coin</p>

    <form action="/admin/task/delete" method="POST" onsubmit="return confirmDelete()">
      <input type="hidden" name="id" value="<%= task._id %>">
      <button type="submit">Delete</button>
    </form>
  </div>
<% }) %>

<script>
function confirmDelete() {
  return confirm("আপনি কি নিশ্চিত এই task delete করতে চান?");
}
</script>

</body>
</html>