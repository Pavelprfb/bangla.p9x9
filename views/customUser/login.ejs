<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>User Login</title>

  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

  <style>
    /* Container */
    .login-wrapper-x1 {
      display: flex;
      justify-content: center;
      height: 40vh;
      background: #ffffff; /* changed এখানে */
    }

    /* Form Box */
    .login-box-x1 {
      background: #fff;
      padding: 30px;
      border-radius: 12px;
      width: 320px;
      box-shadow: 0 10px 25px rgba(0,0,0,0.15);
      text-align: center;
    }

    .login-title-x1 {
      margin-bottom: 20px;
      font-size: 22px;
      font-weight: bold;
      color: #333;
    }

    /* Input group */
    .input-group-x1 {
      position: relative;
      margin-bottom: 18px;
    }

    .input-group-x1 input {
      width: 100%;
      padding: 10px 40px;
      border: 1px solid #ddd;
      border-radius: 8px;
      outline: none;
      font-size: 14px;
      transition: 0.3s;
      display: block;
      margin: auto;
    }

    .input-group-x1 input:focus {
      border-color: #4facfe;
      box-shadow: 0 0 5px rgba(79,172,254,0.5);
    }

    .input-group-x1 i {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      left: 12px;
      color: #999;
    }

    /* Button */
    .login-btn-x1 {
      width: 100%;
      padding: 10px;
      background: #4facfe;
      border: none;
      border-radius: 8px;
      color: white;
      font-size: 15px;
      cursor: pointer;
      transition: 0.3s;
    }

    .login-btn-x1:hover {
      background: #3a8de0;
    }

    /* Link */
    .login-footer-x1 {
      margin-top: 15px;
      font-size: 13px;
    }

    .login-footer-x1 a {
      color: #4facfe;
      text-decoration: none;
      font-weight: bold;
    }

    /* Toast */
    #toast {
      position: fixed;
      top: 20px;
      right: 20px;
      background: #333;
      color: #fff;
      padding: 10px 15px;
      border-radius: 6px;
      opacity: 0;
      transition: 0.3s;
      z-index: 999;
    }

    #toast.show {
      opacity: 1;
    }
  </style>
</head>

<body>
  
  <%- include("../website/nav.ejs") %>

  <div id="toast"></div>

  <div class="login-wrapper-x1">
    <form class="login-box-x1 login-form" id="loginForm">
      <h2 class="login-title-x1">User Login</h2>

      <div class="input-group-x1">
        <i class="fa fa-user"></i>
        <input type="text" name="loginId" placeholder="Username, Email or Number" required>
      </div>

      <div class="input-group-x1">
        <i class="fa fa-lock"></i>
        <input type="password" name="password" placeholder="Password" required>
      </div>

      <button type="submit" class="login-btn-x1">
        <i class="fa fa-sign-in-alt"></i> Login
      </button>

      <p class="login-footer-x1">
        Don't have an account? <a href="/user/signup">Signup</a>
      </p>
    </form>
  </div>

  <script>
    const form = document.getElementById("loginForm");
    const toast = document.getElementById("toast");

    function showToast(message) {
      toast.textContent = message;
      toast.className = "show";
      setTimeout(() => { toast.className = toast.className.replace("show", ""); }, 3500);
    }

    // JS অংশ (unchanged)
    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      const formData = new FormData(form);
      const data = {};
      formData.forEach((value, key) => {
        data[key] = (key === 'loginId') ? value.toLowerCase() : value;
      });

      try {
        const res = await fetch("/user/login", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(data)
        });

        const result = await res.json();

        if (result.success) {
          window.location.href = result.redirect;
        } else {
          showToast(result.message);
        }

      } catch (err) {
        console.error(err);
        showToast("Something went wrong.");
      }
    });
  </script>

  <%- include("../website/footer.ejs") %>
  <%- include("../website/footerNav.ejs") %>
</body>
</html>