<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="ie=edge">
  <title>Task</title>
  <style>
    .taskDataContainer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: #fff;
      margin: 12px;
      padding: 12px;
      border-radius: 12px;
      box-shadow: 0 4px 10px rgba(0,0,0,0.1);
      transition: 0.3s;
    }
    
    .taskDataContainer:hover {
      transform: translateY(-3px);
    }
    
    .taskPic img {
      width: 70px;
      height: 70px;
      border-radius: 10px;
      object-fit: cover;
    }
    
    .taskNameAndCoin {
      flex: 1;
      margin-left: 12px;
    }
    
    .taskNameAndCoin p:first-child {
      font-weight: 600;
    }
    
    .taskNameAndCoin p:last-child {
      color: #00a86b;
      font-weight: bold;
    }
    
    .joinAndCleam a {
      text-decoration: none;
      background: #062cd9;
      color: #fff;
      padding: 8px 14px;
      border-radius: 20px;
      font-size: 13px;
      cursor: pointer;
    }
    
    .joinAndCleam a.disabled {
      background: #aaa;
      cursor: not-allowed;
    }
    .dNone{
      display: none;
    }
    .displayDiv > button{
      border: none;
      padding: 10px 10px;
      background: #062cd9;
      color: white;
      border-radius: 5px;
    }
  </style>
</head>
<body>
    <%- include("../website/nav.ejs") %>
    
    <% if(userData){ %>
    
    
      <div>
          <% if (taskData.length === 0) { %>
            <p>No Task Found</p>
          <% } else { %>
          
          
              <% taskData.forEach(function(data, index) { %>      
                <div class="taskDataContainer">      
                  <div class="taskPic">      
                    <img src="<%= data.taskPic %>" />      
                  </div>      
                  <div class="taskNameAndCoin">      
                    <p><%= data.fullName %></p>      
                    <p><%= data.coin %> টাকা</p>      
                  </div>      
                  <div class="joinAndCleam">      
                    <div class="show">
                      <span class="dataId dNone"><%= data.id %></span>
                      <span class="dataCoin dNone"><%= data.coin %></span>
                      <span class="dataLink dNone"><%= data.link %></span>
                      <span class="dataEmail dNone"><%= data.email %></span>
                      <span class="onlyEmail dNone"><%= email %></span>
                      <div class="displayDiv">Join</div>      
                    </div>     
                  </div>      
                </div>      
              <% }) %>
              
              
          <% } %>
      </div>
      
      
    <% }else{ %>
      <script>
        window.location.href="/user/dashboard"
      </script>
    <% } %>
    
    
    
    <script>
      // সব এলিমেন্টগুলোর জন্য NodeList নিন
      const taskContainers = document.querySelectorAll('.taskDataContainer');
    
      taskContainers.forEach(container => {
        const dataId = container.querySelector('.dataId').innerHTML.trim();
        const dataCoin = container.querySelector('.dataCoin').innerHTML.trim();
        const dataLink = container.querySelector('.dataLink').innerHTML.trim();
        const dataEmail = container.querySelector('.dataEmail').innerHTML.trim();
        const onlyEmail = container.querySelector('.onlyEmail').innerHTML.trim();
        const displayDiv = container.querySelector('.displayDiv');
    
        const singleId = dataId;
        const singleCoin = dataCoin;
        const multipleEmail = dataEmail;
        const singleEmailVal = onlyEmail;
    
        // যদি multipleEmail এ singleEmail থাকে
        if (multipleEmail.includes(singleEmailVal)) {
          displayDiv.innerHTML = `<button>✅ Claimed</button>`;
        } else {
          displayDiv.innerHTML = `<button>Join</button>`;
        }
    
        // বাটনে click ইভেন্ট
        displayDiv.querySelector('button')?.addEventListener('click', (event) => {
          if (event.target.innerHTML == "Join") {
            document.cookie = "name=Cleam; max-age=300";
    
            setTimeout(() => {
              window.location.href = dataLink;
            }, 1000);
    
            setTimeout(() => {
              event.target.innerHTML = "Cleam";
            }, 3000);
          } else {
            const payload = {
              singleId: singleId,
              singleCoin: singleCoin,
              singleEmail: singleEmailVal
            };
    
            fetch('/admin/task/calculate', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json'
              },
              body: JSON.stringify(payload)
            })
            .then(response => response.json())
            .then(data => {
              window.location.reload();
            })
            .catch(error => {
              console.error('Error sending data:', error);
              alert("Error sending data!");
            });
          }
        });
      });
    
      function getCookie(name) {
        const cookies = document.cookie.split("; ");
        for (let cookie of cookies) {
          const [key, value] = cookie.split("=");
          if (key === name) return value;
        }
        return null;
      }
    </script>
    <%- include("../website/footer.ejs") %>
    <%- include("../website/footerNav.ejs") %>
</body>
</html>