<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>User Registration</title>

  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

  <style>
    .register-wrapper-x2 {
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      background: #ffffff;
      padding: 20px;
    }

    .register-box-x2 {
      background: #fff;
      padding: 30px;
      border-radius: 12px;
      width: 340px;
      box-shadow: 0 10px 25px rgba(0,0,0,0.08);
    }

    .register-title-x2 {
      text-align: center;
      margin-bottom: 20px;
      font-size: 22px;
      font-weight: bold;
      color: #333;
    }

    .input-group-x2 {
      position: relative;
      margin-bottom: 15px;
    }

    .input-group-x2 input {
      width: 100%;
      padding: 10px 38px;
      border: 1px solid #ddd;
      border-radius: 8px;
      font-size: 14px;
      outline: none;
      display: block;
      margin: auto;
    }

    .input-group-x2 i {
      position: absolute;
      top: 50%;
      left: 12px;
      transform: translateY(-50%);
      color: #888;
    }

    /* File + Preview */
    .file-group-x2 {
      text-align: center;
      margin-bottom: 15px;
    }

    .file-group-x2 input {
      margin-top: 10px;
    }

    .img-preview-box-x2 {
      width: 120px;
      height: 120px;
      border-radius: 50%;
      overflow: hidden;
      margin: 10px auto;
      border: 2px solid #ddd;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #fafafa;
    }

    .img-preview-box-x2 img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: none; /* আগে hide থাকবে */
    }

    .register-btn-x2 {
      width: 100%;
      padding: 10px;
      background: #4facfe;
      border: none;
      border-radius: 8px;
      color: white;
      font-size: 15px;
      cursor: pointer;
    }

    .register-footer-x2 {
      text-align: center;
      margin-top: 15px;
      font-size: 13px;
    }

    .register-footer-x2 a {
      color: #4facfe;
      text-decoration: none;
      font-weight: bold;
    }
  </style>
</head>

<body>
  <%- include("../website/nav.ejs") %>

  <div class="register-wrapper-x2">
    <form class="register-box-x2 register-form" action="/user/signup" method="POST" enctype="multipart/form-data">
      
      <h2 class="register-title-x2">Create Account</h2>

      <!-- Image Upload -->
      <div class="file-group-x2">
        <i class="fa fa-image"></i>

        <div class="img-preview-box-x2">
          <img id="previewImg" src="" alt="Preview">
        </div>

        <input type="file" name="profilePic" id="profilePic" accept="image/*" required>
      </div>

      <div class="input-group-x2">
        <i class="fa fa-user"></i>
        <input type="text" name="fullName" placeholder="Full Name" required>
      </div>

      <div class="input-group-x2">
        <i class="fa fa-id-badge"></i>
        <input type="text" name="username" placeholder="Username" required>
      </div>

      <div class="input-group-x2">
        <i class="fa fa-envelope"></i>
        <input type="email" name="email" placeholder="Email Address" required>
      </div>

      <div class="input-group-x2">
        <i class="fa fa-phone"></i>
        <input type="number" name="number" placeholder="Phone Number" required>
      </div>

      <div class="input-group-x2">
        <i class="fa fa-calendar"></i>
        <input type="number" name="age" placeholder="Age" required>
      </div>

      <div class="input-group-x2">
        <i class="fa fa-gift"></i>
        <input type="text" name="referCode" id="referCode" placeholder="Refer Code">
      </div>

      <div class="input-group-x2">
        <i class="fa fa-lock"></i>
        <input type="password" name="password" placeholder="Password" required>
      </div>

      <button type="submit" class="register-btn-x2">
        <i class="fa fa-user-plus"></i> Register
      </button>

      <p class="register-footer-x2">
        Already have an account? <a href="/user/login">Login</a>
      </p>
    </form>
  </div>

  <script>
    // refer code logic (UNCHANGED)
    const params = new URLSearchParams(window.location.search);
    const refer = params.get("refer");
    const referInput = document.getElementById("referCode");

    if (refer) {
      referInput.value = refer;
      referInput.readOnly = true;
    } else {
      referInput.readOnly = false;
    }

    // image preview (updated but old logic intact)
    const fileInput = document.getElementById("profilePic");
    const previewImg = document.getElementById("previewImg");

    fileInput.addEventListener("change", function () {
      const file = this.files[0];

      // যদি file remove করে
      if (!file) {
        previewImg.style.display = "none";
        previewImg.src = "";
        return;
      }

      // শুধু image allow
      if (!file.type.startsWith("image/")) {
        alert("Please select a valid image!");
        fileInput.value = "";
        previewImg.style.display = "none";
        return;
      }

      const reader = new FileReader();

      reader.onload = function (e) {
        previewImg.src = e.target.result;
        previewImg.style.display = "block"; // select করার পর show
      };

      reader.readAsDataURL(file);
    });
  </script>

  <%- include("../website/footer.ejs") %>
  <%- include("../website/footerNav.ejs") %>
</body>
</html>