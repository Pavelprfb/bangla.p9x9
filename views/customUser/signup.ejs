<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>User Registration</title>
</head>
<body>

  <form class="register-form" action="/user/signup" method="POST" enctype="multipart/form-data">
    <h2>Create Account</h2>

    <input type="file" name="profilePic" accept="image/*" required>
    <input type="text" name="fullName" placeholder="Full Name" required>
    <input type="text" name="username" placeholder="Username" required>
    <input type="email" name="email" placeholder="Email Address" required>
    <input type="text" name="number" placeholder="Phone Number" required>
    <input type="number" name="age" placeholder="Age" required>
    <input type="text" name="referCode" id="referCode" placeholder="referCode">
    <input type="password" name="password" placeholder="Password" required>

    <button type="submit">Register</button>

    <p>Already have an account? <a href="/user/login">Login</a></p>
  </form>

  <script>
    // URL থেকে query parameter বের করা
    const params = new URLSearchParams(window.location.search);
    const refer = params.get("refer");
  
    const referInput = document.getElementById("referCode");
  
    if (refer) {
      referInput.value = refer;      // input-এ মান বসানো
      referInput.readOnly = true;    // readonly করা
    } else {
      referInput.readOnly = false;   // readonly না
    }
  </script>
</body>
</html>